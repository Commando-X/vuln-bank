                      "insertedContent": {
                        "text": "    \u003cscript\u003e\n        function toggleTheme() {\n            const h = document.documentElement;\n            const n = h.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';\n            h.setAttribute('data-theme', n);\n            try { localStorage.setItem('vb-theme', n); } catch (e) { /* storage unavailable */ }\n        }\n    \u003c/script\u003e"
