        {
          "ruleId": "security",
          "level": "error",
          "message": {
            "text": "Sensitive credentials written to the DOM: hydrateMerchantProfile renders the raw merchant API key and JWT token as textContent of merchantApiKeyValue/merchantTokenValue (plus the full X-Merchant-Api-Key / Authorization headers), and copyMerchantCredential pipes them straight to the clipboard. Storing long-lived secrets in localStorage is already XSS-vulnerable, and then deliberately re-publishing them in the page DOM dramatically increases the blast radius of any XSS, screenshot, or shoulder-surf incident. Mask the values in the UI (e.g. show only the last 4 chars + ellipsis), require explicit re-auth before revealing/copying, and consider moving the JWT into an httpOnly cookie."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "static/merchant.js"
                },
                "region": {
                  "startLine": 155,
