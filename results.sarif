        {
          "ruleId": "bug",
          "level": "warning",
          "message": {
            "text": "Global `img { max-width: 100%; height: auto; }` will collapse inline SVG icons, brand marks, avatars, and any image whose intrinsic aspect ratio is intentional (a 1:1 logo will not scale to a fixed width/height container). It also forces every SVG to scale to its container width, breaking icon sizing. Scope the rule to content images, e.g. `article img, .content img { max-width: 100%; height: auto; }` or apply `.img-fluid` class instead."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "static/style.css"
