                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 129,
                        "endLine": 132
                      },
                      "insertedContent": {
                        "text": ".empty-table {\n  text-align: center;\n  color: var(--text-4);\n  padding: 1.5rem 0;\n  font-size: 0.875rem;\n}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "ruleId": "style",
          "level": "note",
          "message": {
            "text": "`.merchant-table th` is not given `position: sticky` with a top offset. Long tables (especially in the integrations/credentials panels that can be tall) will lose their column-header context as soon as the user scrolls vertically, since `.merchant-table-wrap` only constrains horizontal overflow. Consider `position: sticky; top: 0; background: var(--surface);` on the `\u003cth\u003e` cells (and the table itself may need `border-collapse: separate` for sticky to render reliably across all browsers)."
          },
          "locations": [
