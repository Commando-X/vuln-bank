                      "insertedContent": {
                        "text": "    // Global dismiss function\n    window.dismissVulnDisclaimer = function() {\n        const sheet = document.getElementById('vuln-disclaimer');\n        if (!sheet || sheet.dataset.dismissing === '1') return;\n        sheet.dataset.dismissing = '1';\n        sheet.classList.remove('visible');\n        const onEnd = () =\u003e sheet.remove();\n        sheet.querySelector('.vuln-disclaimer-sheet').addEventListener('transitionend', onEnd, { once: true });\n        // Fallback in case transitionend never fires (e.g., reduced motion)\n        setTimeout(onEnd, 400);\n    };"
                      }
                    }
                  ]
                }
              ]
            }
          ]
