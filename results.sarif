                        "endLine": 548
                      },
                      "insertedContent": {
                        "text": "if amount \u003c= 0:\n            return jsonify({'status': 'error', 'message': 'Amount must be positive'}), 400\n        if balance \u003c amount:"
                      }
                    }
                  ]
                }
              ]
            }
          ]
