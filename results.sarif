                        "text": "# First confirm the server is accepting connections\nuntil pg_isready -h \"${DB_HOST}\" -p \"${DB_PORT}\" \u003e/dev/null 2\u003e\u00261; do\n  sleep 2\ndone\n# Then ensure the target database exists (create it if this is a fresh cluster)\nPGPASSWORD=\"${DB_PASSWORD:-}\" psql -h \"${DB_HOST}\" -p \"${DB_PORT}\" -U \"${DB_USER}\" \\\n  -d postgres -tAc \"SELECT 1 FROM pg_database WHERE datname='${DB_NAME}'\" | grep -q 1 \\\n  || PGPASSWORD=\"${DB_PASSWORD:-}\" psql -h \"${DB_HOST}\" -p \"${DB_PORT}\" -U \"${DB_USER}\" \\\n       -d postgres -c \"CREATE DATABASE \\\"${DB_NAME}\\\"\""
