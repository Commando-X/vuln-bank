                      },
                      "insertedContent": {
                        "text": "          rsync -avz --delete \\\n            --filter 'P .env' \\\n            -e 'ssh' \\\n            ./ \\\n            \"${REMOTE_USER}@${REMOTE_HOST}:/home/${REMOTE_USER}/vuln-bank/\""
                      }
                    }
