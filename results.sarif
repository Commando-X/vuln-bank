          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "static/admin.css"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 960,
                        "endLine": 964
                      },
                      "insertedContent": {
                        "text": "@media (max-width: 1024px) {\n  .admin-sidebar {\n    transform: translateX(-100%);\n  }\n\n  .admin-main {\n    margin-left: 0;\n  }\n}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "ruleId": "bug",
          "level": "error",
          "message": {
            "text": "At widths ≤ 1024px the sidebar is moved off-screen via `transform: translateX(-100%)`, but there is no hamburger button, open/close class (e.g. `.admin-sidebar.is-open`), or `aria-hidden` toggle defined anywhere in this stylesheet. On tablet/mobile, users have no way to access navigation. Add styles for a toggle button (visible only at the responsive breakpoints) and an `.is-open` (or similar) state that resets `transform` to `translateX(0)` and raises the sidebar above the main content."
          },
