        {
          "ruleId": "bug",
          "level": "error",
          "message": {
            "text": "At viewport widths between 769px and 1024px, `.admin-sidebar` is translated off-screen via `transform: translateX(-100%)`, but `.admin-main` still has `margin-left: var(--admin-sidebar-width)` (260px) because the reset only happens in the 768px breakpoint below. This leaves a 260px empty gap on the left of the main content on tablet-sized screens. Either move the `margin-left: 0` reset into this 1024px breakpoint, or hide the sidebar at the same breakpoint that removes the margin."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "static/admin.css"
                },
                "region": {
                  "startLine": 960,
                  "endLine": 964
