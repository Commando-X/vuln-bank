                      },
                      "insertedContent": {
                        "text": ".action-pill-icon.lime   { background: rgba(132,204,22,0.10); color: #84CC16; }\n.action-pill-icon.blue   { background: rgba(0,123,255,0.10); color: var(--brand); }"
                      }
                    }
                  ]
                }
              ]
            }
          ]
