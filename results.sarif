                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 837,
                        "endLine": 845
                      },
                      "insertedContent": {
                        "text": ".user-modal-backdrop {\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  bottom: 0;\n  background: rgba(0, 0, 0, 0.5);\n}\n\n@supports (backdrop-filter: blur(2px)) {\n  .user-modal-backdrop {\n    backdrop-filter: blur(2px);\n  }\n}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
