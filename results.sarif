                        "text": ".btn-primary, .btn-primary[type=\"submit\"] {\n  background: var(--navy-800); color: #fff;\n}\n.btn-primary:hover, .btn-primary[type=\"submit\"]:hover {\n  background: var(--navy-700); transform: translateY(-1px); box-shadow: var(--shadow-md);\n}\n[data-theme=\"dark\"] .btn-primary, [data-theme=\"dark\"] .btn-primary[type=\"submit\"] {\n  background: var(--brand-light); color: #fff;\n}\n[data-theme=\"dark\"] .btn-primary:hover, [data-theme=\"dark\"] .btn-primary[type=\"submit\"]:hover {\n  background: var(--brand);\n}\n\n.btn-primary:active, .btn-primary[type=\"submit\"]:active { transform: scale(0.97); box-shadow: none; }"
