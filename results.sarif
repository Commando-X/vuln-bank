        {
          "ruleId": "performance",
          "level": "warning",
          "message": {
            "text": "`backdrop-filter: blur(4px)` on a full-viewport overlay (`.user-modal-backdrop`) is GPU-expensive and can stutter or flicker on lower-end devices, especially when combined with the modal's other animations. It is also unsupported in older browsers, leaving an unblurred backdrop. Consider lowering the blur radius (e.g. `blur(2px)`), wrapping it in an `@supports` block with a flat darker fallback, or dropping it in favor of a stronger semi-transparent background."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "static/admin.css"
                },
                "region": {
                  "startLine": 837,
