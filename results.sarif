                      "insertedContent": {
                        "text": ".merchant-table th {\n  color: var(--text-3);\n  font-size: 0.6875rem;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n  text-transform: uppercase;\n  background: var(--surface);\n  position: sticky;\n  top: 0;\n  z-index: 1;\n}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
