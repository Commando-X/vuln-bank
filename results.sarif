        {
          "ruleId": "other",
          "level": "warning",
          "message": {
            "text": "`opacity: 0` on `.reveal` hides content if the JS that toggles `.revealed` fails to run (script error, blocked, slow load). Users with JS disabled or assistive tech that ignores JS will see permanently invisible content. Apply the hidden state via the JS-added class only (`html.js .reveal { opacity: 0; ... }`) and gate with `html.no-js .reveal { opacity: 1; transform: none; }` to fail open."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "static/style.css"
                },
                "region": {
                  "startLine": 389,
                  "endLine": 393
                }
              }
