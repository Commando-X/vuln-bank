          },
          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "auth.py"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 171,
                        "endLine": 192
                      },
                      "insertedContent": {
                        "text": "def api_transfer(current_user):\n        data = request.get_json() or {}\n        to_account = data.get('to_account')\n        try:\n            amount = float(data.get('amount'))\n        except (TypeError, ValueError):\n            return jsonify({'error': 'Invalid amount'}), 400\n        if not to_account or not (amount \u003e 0) or amount != amount or amount == float('inf'):\n            return jsonify({'error': 'Invalid transfer details'}), 400\n\n        conn = sqlite3.connect('bank.db')\n        try:\n            c = conn.cursor()\n            try:\n                conn.execute('BEGIN IMMEDIATE')\n                c.execute(\n                    \"UPDATE users SET balance = balance - ? \"\n                    \"WHERE id = ? AND balance \u003e= ?\",\n                    (amount, current_user['user_id'], amount),\n                )\n                if c.rowcount != 1:\n                    conn.execute('ROLLBACK')\n                    return jsonify({'error': 'Insufficient funds'}), 400\n                c.execute(\n                    \"UPDATE users SET balance = balance + ? WHERE account_number = ?\",\n                    (amount, to_account),\n                )\n                if c.rowcount != 1:\n                    conn.execute('ROLLBACK')\n                    return jsonify({'error': 'Recipient not found'}), 404\n                conn.commit()\n            except Exception:\n                conn.execute('ROLLBACK')\n                raise\n        finally:\n            conn.close()"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
