                        "text": "html { font-size: 100%; scroll-behavior: smooth; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }\n@media (prefers-reduced-motion: reduce) {\n  html { scroll-behavior: auto; }\n}"
