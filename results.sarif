                      "insertedContent": {
                        "text": "function dismissToast(toast) {\n    if (!toast.parentElement) return;\n    toast.classList.add('toast-removing');\n    const cleanup = () =\u003e { if (toast.parentElement) toast.remove(); };\n    toast.addEventListener('animationend', cleanup, { once: true });\n    setTimeout(cleanup, 500); // fallback if animation never fires\n}"
                      }
                    }
                  ]
                }
