                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "ruleId": "style",
          "level": "note",
          "message": {
            "text": "`.empty-table` only centers text and sets a muted color; it has no vertical padding or min-height. When rendered as a single `\u003ctd\u003e` placeholder in `.merchant-table`, the empty-state line will hug the cell's `padding: 0.875rem 0.75rem` and look like a single header row instead of an intentional empty state. Add vertical spacing (e.g., `padding: 1.5rem 0;`) and optionally a slightly larger font size to make the empty state distinguishable."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "static/merchant.css"
                },
                "region": {
                  "startLine": 129,
                  "endLine": 132
