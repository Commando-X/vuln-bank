        {
          "ruleId": "bug",
          "level": "note",
          "message": {
            "text": "Theme bootstrap runs before stylesheets and uses localStorage without a guard: The inline script reads `localStorage.getItem(\"vb-theme\")` and sets `data-theme` before the CSS files in `\u003chead\u003e` have loaded, so the first paint uses the default theme and then flips (FOUC). Also, reading localStorage here assumes it is always available (e.g., private-browsing modes can throw on access), which will halt script execution and leave the page on the default theme. Wrap the read in try/catch and, ideally, set the attribute in a blocking inline script placed after the CSS links."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "templates/login.html"
                },
                "region": {
