                        "endLine": 12
                      },
                      "insertedContent": {
                        "text": "echo \"Waiting for PostgreSQL at ${DB_HOST}:${DB_PORT}...\"\ni=0\nmax=60\nuntil pg_isready -h \"${DB_HOST}\" -p \"${DB_PORT}\" -U \"${DB_USER}\" -d \"${DB_NAME}\" \u003e/dev/null 2\u003e\u00261; do\n  i=$((i + 1))\n  if [ \"$i\" -ge \"$max\" ]; then\n    echo \"PostgreSQL not ready after ${max} attempts, aborting.\" \u003e\u00262\n    exit 1\n  fi\n  sleep 2\ndone"
                      }
                    }
                  ]
                }
              ]
            }
          ]
