        {
          "ruleId": "other",
          "level": "error",
          "message": {
            "text": "No `prefers-reduced-motion` guard. All transitions (body color/bg, buttons, theme toggle slider, page-link), keyframe animations (`slideDown`, `spin`), and the reveal utility run unconditionally, which can trigger vestibular symptoms. Wrap motion in a `prefers-reduced-motion: reduce` block that disables transitions/animations and disables smooth scrolling."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "static/style.css"
                },
                "region": {
                  "startLine": 155,
