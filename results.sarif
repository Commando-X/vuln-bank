          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "static/style.css"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 389,
                        "endLine": 393
                      },
                      "insertedContent": {
                        "text": "/* Add \u003chtml class=\"js\"\u003e via an inline script at the top of \u003cbody\u003e */\n.js .reveal {\n  opacity: 0; transform: translateY(20px);\n  transition: opacity var(--dur-slow) var(--ease), transform var(--dur-slow) var(--ease);\n}\n.js .reveal.revealed { opacity: 1; transform: translateY(0); }\n/* No-JS fallback: content is visible by default */"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
