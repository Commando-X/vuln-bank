                      "deletedRegion": {
                        "startLine": 11,
                        "endLine": 12
                      },
                      "insertedContent": {
                        "text": "\u003cscript\u003e\n    (function() {\n        try {\n            var t = localStorage.getItem(\"vb-theme\");\n            document.documentElement.setAttribute(\"data-theme\", t || \"light\");\n        } catch (e) {\n            document.documentElement.setAttribute(\"data-theme\", \"light\");\n        }\n    })();\n    \u003c/script\u003e\n\u003c/head\u003e"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
