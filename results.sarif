                      "insertedContent": {
                        "text": "/* Only constrain content / article images; leave icons, logos, and SVGs alone */\n.img-fluid, article img, .content img { max-width: 100%; height: auto; }"
                      }
                    }
                  ]
                }
              ]
            }
          ]
