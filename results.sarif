                        "text": "@media (max-width: 768px) {\n  .admin-main {\n    margin-left: 0;\n  }\n\n  .admin-sidebar {\n    transform: translateX(-100%);\n    transition: transform 0.25s ease;\n  }\n\n  .admin-sidebar.is-open {\n    transform: translateX(0);\n  }\n\n  .admin-sidebar-toggle {\n    display: inline-flex;\n    /* …button styling… */\n  }\n}"
