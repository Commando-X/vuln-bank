          "level": "warning",
          "message": {
            "text": "Fixing `html { font-size: 16px }` overrides the user's browser-level font-size preference. Users who set a larger default (vision accessibility) will not get any scaling on rem-based typography. Prefer `font-size: 100%` (which equals the user agent default and respects browser settings) and keep all component sizing in rem/em."
          },
          "locations": [
