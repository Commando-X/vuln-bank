        {
          "ruleId": "other",
          "level": "warning",
          "message": {
            "text": "Most interactive elements — `.sidebar-nav-item`, `.sidebar-back-link`, `.theme-toggle-sidebar`, `.btn-text` (and its variants `.btn-view`, `.btn-delete`, `.btn-suspend`), `.btn-approve`, `.page-btn`, `.btn-primary`, `.user-modal-close` — only define `:hover` styles and have no `:focus` / `:focus-visible` outlines. Keyboard users get no visible indication of focus, which is an accessibility failure. Add `:focus-visible` rules (e.g. a 2px outline using `--admin-primary-light` with an offset) consistently across these controls."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "static/admin.css"
                },
                "region": {
                  "startLine": 638,
                  "endLine": 647
