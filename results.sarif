                  "artifactLocation": {
                    "uri": "static/style.css"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 155,
                        "endLine": 162
                      },
                      "insertedContent": {
                        "text": "@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after {\n    transition-duration: 0.001ms !important;\n    animation-duration: 0.001ms !important;\n    animation-iteration-count: 1 !important;\n    scroll-behavior: auto !important;\n  }\n}\nbody {\n  font-family: var(--font-body);\n  font-weight: 400;\n  line-height: 1.6;\n  color: var(--text-1);\n  background: var(--bg);\n  transition: background var(--dur-mid) ease, color var(--dur-mid) ease;\n}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "ruleId": "bug",
          "level": "warning",
          "message": {
            "text": "Globally restyling every `button[type=\"submit\"]` is too broad. It will override intended submit styling on any form the page embeds (e.g., a delete-confirmation modal, a search box, a \"report\" form), and it conflicts with `.btn-secondary` / `.btn-danger` modifiers that also use `type=\"submit\"`. Scope this to a class (e.g., `.btn-primary[type=\"submit\"]` or apply primary styling only to `.btn-primary`)."
