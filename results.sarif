          "fixes": [
            {
              "artifactChanges": [
                {
                  "artifactLocation": {
                    "uri": "static/admin.css"
                  },
                  "replacements": [
                    {
                      "deletedRegion": {
                        "startLine": 638,
                        "endLine": 647
                      },
                      "insertedContent": {
                        "text": ".btn-text {\n  padding: 0.5rem 1rem;\n  border-radius: 8px;\n  border: 1px solid var(--admin-border);\n  background: transparent;\n  cursor: pointer;\n  font-size: 0.875rem;\n  font-weight: 600;\n  transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;\n}\n\n.btn-text:focus-visible {\n  outline: 2px solid var(--admin-primary-light);\n  outline-offset: 2px;\n}"
                      }
                    }
                  ]
                }
              ]
            }
          ]
