DB_NAME=vulnerable_bank
DB_USER=vulnbank_app
DB_HOST=db
DB_PORT=5432

# Database password. Set a real value at deploy time; never commit one.
# The application refuses to start when this is empty.
DB_PASSWORD=

# Bootstrap administrator. Both values are required to create the account.
# When they are absent, no administrator is created at all.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# JWT signing key. Must be at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Flask session secret key. Must be at least 32 characters.
SECRET_KEY=

# External AI provider key (optional).
DEEPSEEK_API_KEY=
