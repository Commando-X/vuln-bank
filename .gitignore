# Environment files. The bare `.env` pattern does NOT cover `.env.local`,
# `.env.production` and friends (CWE-538).
.env
.env.*
!.env.example

*.pyc
__pycache__/
.venv/

# Local audit artifacts
.audit/
bank.db

# Uploaded profile pictures. The directory itself is tracked for its
# default images, but anything uploaded at runtime is not.
static/uploads/*
!static/uploads/admin.png
!static/uploads/banking-app.png
!static/uploads/user.png
